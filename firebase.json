{
  "hosting": [
    {
      "site": "splittrip-in",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    },
    {
      "site": "splittrip-vibhu",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "redirects": [
        { "source": "/", "destination": "https://splittrip-in.web.app/", "type": 301 },
        { "source": "/:path*", "destination": "https://splittrip-in.web.app/:path", "type": 301 }
      ]
    }
  ],
  "firestore": { "rules": "firestore.rules" }
}
