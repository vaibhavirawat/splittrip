rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(gid) { return signedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.memberUids; }

    match /groups/{gid} {
      // Group ids are unguessable; knowing the invite link is what lets someone preview and join.
      allow get: if signedIn();
      allow list: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid
                    && request.auth.uid in request.resource.data.memberUids;
      allow update: if isMember(gid)
                    // or: a new member adding only themselves
                    || (signedIn()
                        && !(request.auth.uid in resource.data.memberUids)
                        && request.auth.uid in request.resource.data.memberUids
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members']));
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      match /expenses/{id} {
        allow read, write: if isMember(gid);
      }
      match /payments/{id} {
        allow read, create: if isMember(gid);
      }
    }
  }
}
